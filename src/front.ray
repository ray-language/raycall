// raycall — the HTTP front: adopts (or starts) the W3C trace, sets the
// deadline budget, and translates RPC errors into honest status codes.
// Responses carry the trace ids each hop saw, so a curl shows the whole
// propagation chain.
import std/json;
from std/json import Json;
import net/webserver;
import net/trace;
import rpc/rpc;
from net/log import logger, with_trace, info, warn, field, field_int, emit;

pub struct FrontOpts {
    orders_pool: rpc.Pool,
    inventory_pool: rpc.Pool,
}

// Pooled RPC (rpc.pool): connections are reused, a caller parks when the pool
// is exhausted, and a connection reconnects on its own after a failed call.
fn call_rpc(
    pool: rpc.Pool,
    method: string,
    params: Json,
    deadline_ms: int,
    traceparent: string
) -> Result<Json, string> {
    rpc.pool_call_full(pool, method, params, deadline_ms, traceparent)
}

fn err_response(t: trace.Trace, e: string) -> webserver.Response {
    let status = if (e.contains("insufficient")) {
        409
    } else if (e.contains("timeout") || e.contains("deadline")) {
        504
    } else {
        502
    };
    var m: Map<string, Json> = Map.new();
    m.insert("error", Json.JStr(e));
    m.insert("trace_id", Json.JStr(t.trace_id));
    var resp = webserver.json_response(json.stringify(Json.JObject(m)));
    resp.status = status;
    resp
}

pub fn handle(opts: FrontOpts, req: webserver.Request) -> webserver.Response {
    let t = webserver.trace_of(req);
    let lg = with_trace(logger("raycall-front"), t.trace_id);
    let deadline_ms = match (req.headers.get("x-deadline-ms")) {
        Option.Some(v) => parse_int(v).unwrap_or(2000),
        Option.None => 2000,
    };
    let child_tp = trace.traceparent(trace.child(t));
    if (req.method == "POST" && req.path == "/orders") {
        let body = from_utf8(req.body).unwrap_or("");
        let params = match (json.parse(body)) {
            Result.Ok(j) => j,
            Result.Err(e) => {
                return err_response(t, "bad json body");
            },
        };
        match (call_rpc(opts.orders_pool, "place_order", params, deadline_ms, child_tp)) {
            Result.Ok(res) => {
                emit(field(info(lg, "order placed"), "route", "/orders"));
                var m = json.as_object(res).unwrap_or(Map.new());
                m.insert("trace_id", Json.JStr(t.trace_id));
                webserver.json_response(json.stringify(Json.JObject(m)))
            },
            Result.Err(e) => {
                emit(field(warn(lg, "order failed"), "error", e));
                err_response(t, e)
            },
        }
    } else if (req.method == "GET" && req.path.starts_with("/stock/")) {
        let sku = req.path.substring(7, req.path.len());
        var params: Map<string, Json> = Map.new();
        params.insert("sku", Json.JStr(sku));
        match (call_rpc(
            opts.inventory_pool,
            "get_stock",
            Json.JObject(params),
            deadline_ms,
            child_tp
        )) {
            Result.Ok(res) => {
                var m = json.as_object(res).unwrap_or(Map.new());
                m.insert("trace_id", Json.JStr(t.trace_id));
                webserver.json_response(json.stringify(Json.JObject(m)))
            },
            Result.Err(e) => err_response(t, e),
        }
    } else if (req.path == "/health") {
        webserver.ok("ok\n")
    } else {
        webserver.not_found()
    }
}

pub fn serve(port: int, opts: FrontOpts) -> Result<int, string> {
    webserver.serve_graceful("127.0.0.1", port, 1000, fn(req: webserver.Request) -> webserver.Response {
        handle(opts, req)
    })
}
