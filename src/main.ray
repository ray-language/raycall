// raycall — three microservices wired end to end: HTTP front → orders (RPC)
// → inventory (RPC), with W3C trace propagation and cascading deadlines.
import std/net;
import rpc/rpc;
import inventory;
import orders;
import front;

fn usage() {
    eprint("usage:");
    eprint("  raycall inventory [--port N]                       (default 7481)");
    eprint("  raycall orders    [--port N] [--inventory-port N]  (default 7482)");
    eprint("  raycall front     [--port N] [--orders-port N] [--inventory-port N]  (default 7480)");
    eprint("  raycall demo      (the three of them in one process + sample requests)");
    eprint("");
    eprint("  HTTP: POST /orders {sku, qty}  ·  GET /stock/SKU  ·  X-Deadline-Ms header");
}

fn flag_int(av: [string], name: string, fallback: int) -> int {
    var i = 0;
    while (i + 1 < av.len()) {
        if (av[i] == name) {
            match (parse_int(av[i + 1])) {
                Option.Some(n) => {
                    return n;
                },
                Option.None => {
                    return fallback;
                },
            }
        }
        i = i + 1;
    }
    fallback
}

// The three services in one process, each on a listener already bound (pass
// `net.tcp_listen("127.0.0.1", 0)` for ephemeral ports): the services are
// reachable as soon as this returns, no startup sleep needed.
pub fn boot_on(inv_l: int, ord_l: int, front_l: int) {
    let inv_port = net.local_port(inv_l);
    let ord_port = net.local_port(ord_l);
    spawn(fn() {
        inventory.serve_on(inv_l);
    });
    spawn(fn() {
        orders.serve_on(ord_l, orders.Upstream { pool: rpc.pool("127.0.0.1", inv_port, 8) });
    });
    spawn(fn() {
        front.serve_on(
            front_l,
            front.FrontOpts {
                orders_pool: rpc.pool("127.0.0.1", ord_port, 8),
                inventory_pool: rpc.pool("127.0.0.1", inv_port, 8)
            }
        );
    });
}

pub fn boot_all(inv_port: int, ord_port: int, front_port: int) -> Result<int, string> {
    let inv_l = net.tcp_listen("127.0.0.1", inv_port)?;
    let ord_l = net.tcp_listen("127.0.0.1", ord_port)?;
    let front_l = net.tcp_listen("127.0.0.1", front_port)?;
    boot_on(inv_l, ord_l, front_l);
    Result.Ok(front_port)
}

fn main() -> int {
    let av = args();
    if (av.len() < 1 || av[0] == "--help" || av[0] == "-h") {
        usage();
        return if (av.len() < 1) { 1 } else { 0 };
    }
    let cmd = av[0];
    if (cmd == "inventory") {
        match (inventory.serve(flag_int(av, "--port", 7481))) {
            Result.Ok(n) => 0,
            Result.Err(e) => {
                eprint("raycall: " + e);
                1
            },
        }
    } else if (cmd == "orders") {
        match (orders.serve(
            flag_int(av, "--port", 7482),
            orders.Upstream {
                pool: rpc.pool("127.0.0.1", flag_int(av, "--inventory-port", 7481), 8)
            }
        )) {
            Result.Ok(n) => 0,
            Result.Err(e) => {
                eprint("raycall: " + e);
                1
            },
        }
    } else if (cmd == "front") {
        match (front.serve(
            flag_int(av, "--port", 7480),
            front.FrontOpts {
                orders_pool: rpc.pool("127.0.0.1", flag_int(av, "--orders-port", 7482), 8),
                inventory_pool: rpc.pool("127.0.0.1", flag_int(av, "--inventory-port", 7481), 8)
            }
        )) {
            Result.Ok(n) => 0,
            Result.Err(e) => {
                eprint("raycall: " + e);
                1
            },
        }
    } else if (cmd == "demo") {
        if let Result.Err(e) = boot_all(7481, 7482, 7480) {
            eprint("raycall: " + e);
            return 1;
        }
        eprint("raycall demo on http://127.0.0.1:7480 — try:");
        eprint("  curl -s localhost:7480/stock/tornillo");
        eprint("  curl -s -X POST localhost:7480/orders -d '{\"sku\":\"tornillo\",\"qty\":3}'");
        recv(signals());
        0
    } else {
        usage();
        1
    }
}
